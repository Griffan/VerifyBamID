# Long-read pileup checks on data generated by MakeLongReadTestData (see that
# file for the reads and the reference bases at each marker). MODE is one of:
#   setup               generate the reads and write the marker panel
#   bam, cram           detect long reads automatically and check every .Pileup row
#   discard_near_indel_off
#                       check every .Pileup row of long reads with --DiscardNearIndel 0
#   short_read_type     check that --ReadType short keeps BAQ and --adjust-MQ 40,
#                       discards no bases near indels and counts every alignment
#   short_reads_count_every_alignment
#                       check that short reads count both alignments of a fold-back read
#   explicit_adjust_mq  check that long reads keep an explicit --adjust-MQ
#   explicit_discard_near_indel
#                       check that short reads discard bases near indels when asked to
#   huge_discard_near_indel
#                       check that the largest value spares reads without indels
#   discard_near_indel_with_pileup_file
#                       check the warning that --DiscardNearIndel has no effect there
#   unknown_read_type, adjust_mq_below_minus_one, discard_near_indel_below_minus_one
#                       check that the invalid option value is rejected
#   truncated_bam       check that a read error stops the run
# Every run sets malloc scribbling so a use-after-free tends to crash.
set(prefix "${TEST_DIR}/reads")

# Runs VerifyBamID on `input` with output prefix `name` plus any extra options,
# and sets `log` in the caller to everything it printed.
function(run_verify_bam_id name input)
    execute_process(
        COMMAND ${CMAKE_COMMAND} -E env MallocScribble=1 MALLOC_PERTURB_=165
            "${VERIFY_BAM_ID}" --BamFile "${input}" --Reference "${prefix}.fa"
            --SVDPrefix "${prefix}" --Output "${TEST_DIR}/${name}" --OutputPileup
            --WithinAncestry --FixPC 0:0 --DisableSanityCheck ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${name} failed (${status}):\n${stdout}\n${stderr}")
    endif()
    set(log "${stdout}${stderr}" PARENT_SCOPE)
endfunction()

# Runs VerifyBamID like run_verify_bam_id, but requires it to fail with an
# error message containing `expected`.
function(expect_failure name input expected)
    execute_process(
        COMMAND ${CMAKE_COMMAND} -E env MallocScribble=1 MALLOC_PERTURB_=165
            "${VERIFY_BAM_ID}" --BamFile "${input}" --Reference "${prefix}.fa"
            --SVDPrefix "${prefix}" --Output "${TEST_DIR}/${name}" --OutputPileup
            --WithinAncestry --FixPC 0:0 --DisableSanityCheck ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    string(FIND "${stdout}${stderr}" "${expected}" found)
    if(status EQUAL 0 OR found EQUAL -1)
        message(FATAL_ERROR "${name}: expected failure with '${expected}', got status ${status}:\n${stdout}\n${stderr}")
    endif()
endfunction()

# Fails unless `log` contains `expected`.
function(require_log name log expected)
    string(FIND "${log}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${name}: log lacks '${expected}':\n${log}")
    endif()
endfunction()

# Fails if `log` contains `unexpected`.
function(forbid_log name log unexpected)
    string(FIND "${log}" "${unexpected}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "${name}: log should not contain '${unexpected}':\n${log}")
    endif()
endfunction()

# Fails unless the .Pileup written by run `name` equals `expected_rows`.
function(require_pileup name expected_rows)
    file(READ "${TEST_DIR}/${name}.Pileup" rows)
    if(NOT rows STREQUAL expected_rows)
        message(FATAL_ERROR "${name}: unexpected pileup.\nExpected:\n${expected_rows}\nGot:\n${rows}")
    endif()
endfunction()

# Fails unless the .Pileup written by run `name` has a row for each marker
# (contig:pos) listed after PRESENT, and none for each listed after ABSENT.
function(check_marker_rows name)
    file(READ "${TEST_DIR}/${name}.Pileup" rows)
    set(want_row TRUE)
    foreach(item ${ARGN})
        if(item STREQUAL "PRESENT")
            set(want_row TRUE)
        elseif(item STREQUAL "ABSENT")
            set(want_row FALSE)
        else()
            string(REPLACE ":" "\t" key "${item}")
            string(FIND "${rows}" "${key}\t" found)
            if(want_row AND found EQUAL -1)
                message(FATAL_ERROR "${name}: no row for ${item}:\n${rows}")
            elseif(NOT want_row AND NOT found EQUAL -1)
                message(FATAL_ERROR "${name}: unexpected row for ${item}:\n${rows}")
            endif()
        endif()
    endforeach()
endfunction()

# Rows for the markers before chr1:4003, which no long-read filter changes.
# Rows follow the panel, so the repeated marker appears twice. At chr1:4001
# the forward read has a deletion, which contributes no base and no quality.
string(CONCAT unfiltered_rows
    "chr1\t4001\tA\t1\t,\t?\n"
    "chr1\t2001\tA\t2\tC,\tI?\n"
    "chr1\t2002\tA\t2\t.,\t5?\n"
    "chr1\t2001\tA\t2\tC,\tI?\n"
    "chr2\t3001\tA\t1\t.\tI\n")

if(MODE STREQUAL "setup")
    file(REMOVE_RECURSE "${TEST_DIR}")
    file(MAKE_DIRECTORY "${TEST_DIR}")
    execute_process(COMMAND "${MAKE_DATA}" "${prefix}" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Could not generate the long-read test data")
    endif()
    # Out of order, with a repeated marker, one on a contig the reads lack, and
    # one no read covers.
    set(markers chr1:4001 chr1:2001 chr1:2002 chr1:2001 chr2:3001 chrUn:101 chr1:15001
        chr1:4003 chr2:5998 chr2:5999 chr2:6002 chr2:6003 chr2:7001 chr2:7601 chr2:7901
        chr1:9998 chr1:9999 chr1:12001 chr1:13001 chr1:14001 chr1:17001 chr2:9502 chr1:21301
        chr1:24351 chr1:27001 chr1:28503 chr1:28504 chr1:29598 chr1:29600)
    set(bed "")
    set(mu "")
    set(ud "")
    foreach(marker ${markers})
        string(REPLACE ":" ";" parts "${marker}")
        list(GET parts 0 contig)
        list(GET parts 1 pos)
        math(EXPR start "${pos} - 1")
        string(APPEND bed "${contig}\t${start}\t${pos}\tA\tC\n")
        string(APPEND mu "${contig}:${pos}\t1\n")
        string(APPEND ud "0\t0\n")
    endforeach()
    file(WRITE "${prefix}.bed" "${bed}")
    file(WRITE "${prefix}.mu" "${mu}")
    file(WRITE "${prefix}.UD" "${ud}")

elseif(MODE STREQUAL "bam" OR MODE STREQUAL "cram")
    run_verify_bam_id(${MODE} "${prefix}.${MODE}")
    foreach(expected
            "Detected long reads"
            "Pileup settings: BAQ off, --adjust-MQ 0, --DiscardNearIndel 2, each read counted once per marker"
            "Skipping 1 marker(s) on 1 contig(s) absent from the BAM/CRAM header: chrUn"
            "Ignoring 1 repeated marker position(s)"
            "Discarded 8 base(s) within 2 aligned base(s) of an indel in their read"
            "aligned more than once at a marker 9 time(s), and 5 of those were discarded")
        require_log(${MODE} "${log}" "${expected}")
    endforeach()
    # Bases at most 2 aligned bases from an indel are discarded: del_alt's at
    # chr1:4003, eqx's at chr1:9999 and eqx_left's at 28503 (a mismatch between
    # the base and the deletion counts as aligned), padded's at 29600 (padding
    # is passed over), and near_ins's at chr2:5999 and 6002. Kept: eqx's at
    # chr1:9998, eqx_left's at 28504, padded's at 29598, near_ins's at
    # chr2:5998 and 6003 (its soft clip shifts every query position), and
    # skip_after_ins's at chr2:9502 (the reference skip ends the search before
    # the insertion). Each read counts once per marker:
    #   chr2:7001, 7901  the copies agree, so the Q40 copy is kept, whether it
    #                    comes second or first
    #   chr2:7601        the copies differ, so neither is kept
    #   chr1:12001       likewise, although the reference copy is also near an
    #                    insertion and would be discarded anyway
    #   chr1:13001       one copy is a deletion, so neither is kept
    #   chr1:14001       the copies agree but the Q40 copy is near an insertion,
    #                    so the Q30 copy is kept
    #   chr1:17001       the alt copy is Q5, below --min-BQ, but still vetoes
    #   chr1:21301       the copies tie at Q30, so the first is kept
    #   chr1:24351       a third copy differs, so none is kept
    #   chr1:27001       reads named "*" have no name, so both count
    string(CONCAT expected_rows "${unfiltered_rows}"
        "chr1\t4003\tA\t1\t,\t?\n"
        "chr2\t5998\tA\t1\t.\tI\n"
        "chr2\t6003\tA\t1\t.\tI\n"
        "chr2\t7001\tA\t1\t,\tI\n"
        "chr2\t7601\tA\t1\t.\t5\n"
        "chr2\t7901\tA\t1\t.\tI\n"
        "chr1\t9998\tA\t1\t.\tI\n"
        "chr1\t12001\tA\t1\t.\t5\n"
        "chr1\t13001\tA\t1\t.\t5\n"
        "chr1\t14001\tA\t1\t,\t?\n"
        "chr1\t17001\tA\t1\t.\t5\n"
        "chr2\t9502\tA\t1\t.\tI\n"
        "chr1\t21301\tA\t1\t.\t?\n"
        "chr1\t24351\tA\t1\t.\t5\n"
        "chr1\t27001\tA\t2\t.C\tII\n"
        "chr1\t28504\tA\t1\t.\tI\n"
        "chr1\t29598\tA\t1\t.\tI\n")
    require_pileup(${MODE} "${expected_rows}")

elseif(MODE STREQUAL "discard_near_indel_off")
    run_verify_bam_id(${MODE} "${prefix}.bam" --DiscardNearIndel 0)
    require_log(${MODE} "${log}" "--adjust-MQ 0, --DiscardNearIndel 0, each read counted once per marker")
    # As for "bam", but with every base near an indel kept: at chr1:14001 both
    # copies are now usable, so the Q40 copy is kept.
    string(CONCAT expected_rows "${unfiltered_rows}"
        "chr1\t4003\tA\t2\t.,\tI?\n"
        "chr2\t5998\tA\t1\t.\tI\n"
        "chr2\t5999\tA\t1\t.\tI\n"
        "chr2\t6002\tA\t1\t.\tI\n"
        "chr2\t6003\tA\t1\t.\tI\n"
        "chr2\t7001\tA\t1\t,\tI\n"
        "chr2\t7601\tA\t1\t.\t5\n"
        "chr2\t7901\tA\t1\t.\tI\n"
        "chr1\t9998\tA\t1\t.\tI\n"
        "chr1\t9999\tA\t1\t.\tI\n"
        "chr1\t12001\tA\t1\t.\t5\n"
        "chr1\t13001\tA\t1\t.\t5\n"
        "chr1\t14001\tA\t1\t.\tI\n"
        "chr1\t17001\tA\t1\t.\t5\n"
        "chr2\t9502\tA\t1\t.\tI\n"
        "chr1\t21301\tA\t1\t.\t?\n"
        "chr1\t24351\tA\t1\t.\t5\n"
        "chr1\t27001\tA\t2\t.C\tII\n"
        "chr1\t28503\tA\t1\t.\tI\n"
        "chr1\t28504\tA\t1\t.\tI\n"
        "chr1\t29598\tA\t1\t.\tI\n"
        "chr1\t29600\tA\t1\t.\tI\n")
    require_pileup(${MODE} "${expected_rows}")

elseif(MODE STREQUAL "short_read_type")
    run_verify_bam_id(${MODE} "${prefix}.bam" --ReadType short)
    require_log(${MODE} "${log}" "Using short reads as set by --ReadType")
    require_log(${MODE} "${log}" "Pileup settings: BAQ on, --adjust-MQ 40, --DiscardNearIndel 0")
    forbid_log(${MODE} "${log}" "each read counted once")
    forbid_log(${MODE} "${log}" "Discarded")

elseif(MODE STREQUAL "short_reads_count_every_alignment")
    # BAQ can lower these qualities, so only the depth is checked: both of
    # fold_agree's alignments count at chr2:7001.
    run_verify_bam_id(${MODE} "${prefix}.bam" --ReadType short)
    file(READ "${TEST_DIR}/${MODE}.Pileup" rows)
    string(FIND "${rows}" "chr2\t7001\tA\t2\t" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${MODE}: expected two observations at chr2:7001, got:\n${rows}")
    endif()

elseif(MODE STREQUAL "explicit_discard_near_indel")
    run_verify_bam_id(${MODE} "${prefix}.bam" --ReadType short --DiscardNearIndel 3)
    require_log(${MODE} "${log}" "Pileup settings: BAQ on, --adjust-MQ 40, --DiscardNearIndel 3")
    require_log(${MODE} "${log}" "within 3 aligned base(s) of an indel in their read")
    check_marker_rows(${MODE} PRESENT chr2:3001 ABSENT chr2:5998 chr2:5999 chr2:6002 chr2:6003 chr1:9998)

elseif(MODE STREQUAL "huge_discard_near_indel")
    # The largest value discards every base in a read with an indel, but none
    # in a read without one.
    run_verify_bam_id(${MODE} "${prefix}.bam" --DiscardNearIndel 2147483647)
    check_marker_rows(${MODE} PRESENT chr2:3001 chr1:24351 ABSENT chr2:6003 chr1:28504)

elseif(MODE STREQUAL "discard_near_indel_with_pileup_file")
    file(WRITE "${TEST_DIR}/${MODE}.in.pileup" "chr2\t3001\tA\t1\t.\tI\n")
    execute_process(
        COMMAND "${VERIFY_BAM_ID}" --PileupFile "${TEST_DIR}/${MODE}.in.pileup" --Reference "${prefix}.fa"
            --SVDPrefix "${prefix}" --Output "${TEST_DIR}/${MODE}" --WithinAncestry --FixPC 0:0
            --DisableSanityCheck --DiscardNearIndel 2
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${MODE} failed (${status}):\n${stdout}\n${stderr}")
    endif()
    require_log(${MODE} "${stdout}${stderr}" "--DiscardNearIndel has no effect with --PileupFile")

elseif(MODE STREQUAL "explicit_adjust_mq")
    run_verify_bam_id(${MODE} "${prefix}.bam" --ReadType long --adjust-MQ 20)
    require_log(${MODE} "${log}" "Pileup settings: BAQ off, --adjust-MQ 20")

elseif(MODE STREQUAL "unknown_read_type")
    expect_failure(${MODE} "${prefix}.bam" "--ReadType must be auto, short or long" --ReadType ont)

elseif(MODE STREQUAL "adjust_mq_below_minus_one")
    expect_failure(${MODE} "${prefix}.bam" "--adjust-MQ must be -1 (by read type), 0 (off) or positive" --adjust-MQ -2)

elseif(MODE STREQUAL "discard_near_indel_below_minus_one")
    expect_failure(${MODE} "${prefix}.bam" "--DiscardNearIndel must be -1 (by read type), 0 (off) or positive"
        --DiscardNearIndel -2)

elseif(MODE STREQUAL "truncated_bam")
    expect_failure(${MODE} "${prefix}.truncated.bam" "Failed while reading alignments" --ReadType long)

else()
    message(FATAL_ERROR "Unknown MODE '${MODE}'")
endif()
